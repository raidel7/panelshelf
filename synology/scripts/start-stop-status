#!/bin/sh

PACKAGE_NAME="PanelShelf"
PACKAGE_DIR="${SYNOPKG_PKGDEST:-/var/packages/${PACKAGE_NAME}/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/${PACKAGE_NAME}/var}"
PID_FILE="${VAR_DIR}/panelshelf.pid"
LOG_FILE="${VAR_DIR}/panelshelf.log"
NODE_BIN="${PACKAGE_DIR}/bin/node"
SERVER_FILE="${PACKAGE_DIR}/app/src/server.js"
ENV_FILE="${VAR_DIR}/panelshelf.env"

# Optional operator settings, kept beside the data rather than in the package
# directory, which is replaced wholesale on every upgrade. This is how someone
# behind a reverse proxy sets PANELSHELF_ALLOWED_HOSTS and
# PANELSHELF_TRUSTED_PROXY without editing a file the next release overwrites.
#
# Parsed rather than sourced. Sourcing is the usual shape for a file like this
# and it is the wrong one here: PanelShelf writes to this directory itself, so
# a future path bug that could plant a file would become a way to run commands
# as the package user on the next restart. Only PANELSHELF_ names are read, and
# the value is taken literally.
load_env_file() {
    [ -f "${ENV_FILE}" ] || return 0
    while IFS= read -r line || [ -n "${line}" ]; do
        line="${line%"${line##*[! ]}"}"
        line="$(printf '%s' "${line}" | tr -d '\r')"
        case "${line}" in
            ''|'#'*) continue ;;
            *=*) ;;
            *) continue ;;
        esac
        key="${line%%=*}"
        value="${line#*=}"
        # Spelled out rather than [A-Z_]: a range in a glob is collated by
        # locale, and under some of them it quietly matches lowercase too, so
        # the same file would be read differently on two shells.
        case "${key}" in
            PANELSHELF_[ABCDEFGHIJKLMNOPQRSTUVWXYZ_]*) ;;
            *) continue ;;
        esac
        # One layer of surrounding quotes, which is what anyone writing this
        # by hand will reach for out of habit.
        case "${value}" in
            \"*\") value="${value#\"}" ; value="${value%\"}" ;;
            "'"*"'") value="${value#\'}" ; value="${value%\'}" ;;
        esac
        export "${key}=${value}"
    done < "${ENV_FILE}"
}

is_running() {
    if [ ! -f "${PID_FILE}" ]; then
        return 1
    fi
    pid="$(cat "${PID_FILE}" 2>/dev/null)"
    if [ -z "${pid}" ]; then
        return 1
    fi
    kill -0 "${pid}" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then
            exit 0
        fi
        if [ ! -x "${NODE_BIN}" ] || [ ! -f "${SERVER_FILE}" ]; then
            echo "PanelShelf installation is incomplete." > "${SYNOPKG_TEMP_LOGFILE:-/dev/stderr}"
            exit 1
        fi
        umask 077
        mkdir -p "${VAR_DIR}" "${VAR_DIR}/covers" "${VAR_DIR}/tmp"
        cd "${PACKAGE_DIR}/app" || exit 1
        load_env_file
        # Host, port and data directory stay the package's to decide: the DSM
        # shortcut and the firewall rule are written against them, so letting
        # the file move the port would break both without saying so.
        PANELSHELF_HOST="0.0.0.0" \
        PANELSHELF_PORT="8251" \
        PANELSHELF_DATA="${VAR_DIR}" \
        NODE_ENV="production" \
        nohup "${NODE_BIN}" "${SERVER_FILE}" >> "${LOG_FILE}" 2>&1 &
        pid=$!
        echo "${pid}" > "${PID_FILE}"
        sleep 1
        if ! kill -0 "${pid}" 2>/dev/null; then
            rm -f "${PID_FILE}"
            echo "PanelShelf failed to start. See ${LOG_FILE}." > "${SYNOPKG_TEMP_LOGFILE:-/dev/stderr}"
            exit 1
        fi
        exit 0
        ;;
    stop)
        if ! is_running; then
            rm -f "${PID_FILE}"
            exit 0
        fi
        pid="$(cat "${PID_FILE}")"
        kill "${pid}" 2>/dev/null || true
        count=0
        while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 20 ]; do
            sleep 1
            count=$((count + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            kill -9 "${pid}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}"
        exit 0
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 1
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    *)
        echo "Usage: $0 {start|stop|status|log}" >&2
        exit 1
        ;;
esac
